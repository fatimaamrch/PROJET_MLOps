# Copy to .env and adjust if needed. Values here override configs/config.yaml.
# Local SQLite backend by default -> everything stays on your machine.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=telco-churn

# Registered model served by the API (models:/<name>@<alias>)
MODEL_NAME=TelcoChurnClassifier
MODEL_ALIAS=champion

# Fallback local export used by the API / Docker image
MODEL_PATH=artifacts/model.joblib
